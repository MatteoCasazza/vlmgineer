<?xml version="1.0"?>
<robot name="laid_down_cylinder_with_two_stands">

  <!-- ================= Cylinder Link ================= -->
  <link name="cylinder_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.00010"  ixy="0.0"    ixz="0.0"
        iyy="0.04172"  iyz="0.0"
        izz="0.04172"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.02" length="2.0"/>
      </geometry>
      <material name="SmoothWhite">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.02" length="2.0"/>
      </geometry>
    </collision>
  </link>

  <!-- ================ Stand #1 (at x = -0.1) ================ -->
  <link name="left_cuboid_end1">
    <inertial>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001704" ixy="0.0"    ixz="0.0"
        iyy="0.0001704" iyz="0.0"
        izz="0.0000075"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.2"/>
      </geometry>
      <material name="Gray">
        <color rgba="0.6 0.6 0.6 0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.2"/>
      </geometry>
    </collision>
  </link>

  <link name="right_cuboid_end1">
    <inertial>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001704" ixy="0.0"    ixz="0.0"
        iyy="0.0001704" iyz="0.0"
        izz="0.0000075"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.2"/>
      </geometry>
      <material name="Gray">
        <color rgba="0.6 0.6 0.6 0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.2"/>
      </geometry>
    </collision>
  </link>

  <!-- ================ Stand #2 (at x = +0.1) ================ -->
  <link name="left_cuboid_end2">
    <inertial>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001704" ixy="0.0"    ixz="0.0"
        iyy="0.0001704" iyz="0.0"
        izz="0.0000075"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.2"/>
      </geometry>
      <material name="Gray">
        <color rgba="0.6 0.6 0.6 0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.2"/>
      </geometry>
    </collision>
  </link>

  <link name="right_cuboid_end2">
    <inertial>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001704" ixy="0.0"    ixz="0.0"
        iyy="0.0001704" iyz="0.0"
        izz="0.0000075"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.2"/>
      </geometry>
      <material name="Gray">
        <color rgba="0.6 0.6 0.6 0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.2"/>
      </geometry>
    </collision>
  </link>

  <!-- =================== Joints =================== -->
  <joint name="cyl_to_left_end1" type="fixed">
    <parent link="cylinder_link"/>
    <child  link="left_cuboid_end1"/>
    <origin xyz="-1.0 0 0" rpy="0 2.3562 -1.5708"/>
  </joint>
  <joint name="cyl_to_right_end1" type="fixed">
    <parent link="cylinder_link"/>
    <child  link="right_cuboid_end1"/>
    <origin xyz="-1.0 0 0" rpy="0 -2.3562 -1.5708"/>
  </joint>
  <joint name="cyl_to_left_end2" type="fixed">
    <parent link="cylinder_link"/>
    <child  link="left_cuboid_end2"/>
    <origin xyz="1.0 0 0" rpy="0 2.3562 1.5708"/>
  </joint>
  <joint name="cyl_to_right_end2" type="fixed">
    <parent link="cylinder_link"/>
    <child  link="right_cuboid_end2"/>
    <origin xyz="1.0 0 0" rpy="0 -2.3562 1.5708"/>
  </joint>

</robot>
