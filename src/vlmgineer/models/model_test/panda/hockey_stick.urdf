<?xml version="1.0"?>
<robot name="hockey_stick">

  <!-- brown material -->
  <material name="brown">
    <color rgba="0.59 0.29 0.0 1.0"/>
  </material>

  <!-- single link for the hockey stick -->
  <link name="hockey_stick_link">

    <inertial>
      <origin xyz="0.000060 -0.098605 0.074855" rpy="0 0 0" />
      <inertia 
        ixx="0.0001" ixy="0.0" ixz="0.0"
        iyy="0.0001" iyz="0.0" izz="0.0"/>
      <mass value="0.2" />
    </inertial>

    <!-- VISUAL: handle -->
    <visual name="broom_handle_visual">
      <origin xyz="0.128 0 0.2865" rpy="2.705260 3.141593 -1.5708"/>
      <geometry>
        <box size="0.011 0.021 0.600000"/>
      </geometry>
      <material name="brown"/>
    </visual>
    <!-- COLLISION: handle -->
    <collision name="broom_handle_collision">
      <origin xyz="0.128 0 0.2865" rpy="2.705260 3.141593 -1.5708"/>
      <geometry>
        <box size="0.011 0.021 0.600000"/>
      </geometry>
    </collision>

    <!-- BLADE -->
    <visual name="blade_visual">
      <!-- 0.30 m long × 0.08 m wide × 0.02 m thick, angled -->
      <origin xyz="0.32 0 0.03" rpy="1.5708 0 0"/>
      <geometry>
        <box size="0.15 0.04 0.011"/>
      </geometry>
      <material name="brown"/>
    </visual>
    <collision name="blade_collision">
      <origin xyz="0.32 0 0.03" rpy="1.5708 0.0 0"/>
      <geometry>
        <box size="0.15 0.04 0.011"/>
      </geometry>
    </collision>

  </link>

  <!--
  Uncomment and adjust to mount to your robot flange:

  <joint name="hockey_stick_mount" type="fixed">
    <parent link="ee_link"/>
    <child  link="hockey_stick_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  -->

</robot>
