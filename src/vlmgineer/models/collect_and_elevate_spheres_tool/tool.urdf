<?xml version="1.0"?>
<robot name="spatula">

    <link name="spatula_link">
    <!-- simple inertial (you can calculate exact inertia if you like) -->
    <inertial>
      <origin xyz="0.15 0 0.0025" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia
        ixx="0.0001" ixy="0.0" ixz="0.0"
        iyy="0.0001" iyz="0.0"
        izz="0.0001"/>
    </inertial>

    <!-- HANDLE -->
    <visual name="handle_visual">
      <origin xyz="0.114 0 0.0262" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.02 0.005"/>
      </geometry>
      <material name="gray">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision name="handle_collision">
      <origin xyz="0.114 0 0.0262" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.02 0.005"/>
      </geometry>
    </collision>

    <!-- NECK -->
    <visual name="neck_visual">
      <origin xyz="0.185 0 0.0145" rpy="0 0.5 0"/>
      <geometry>
        <box size="0.05 0.02 0.005"/>
      </geometry>
      <material name="gray">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision name="neck_collision">
      <origin xyz="0.185 0 0.0145" rpy="0 0.5 0"/>
      <geometry>
        <box size="0.05 0.02 0.005"/>
      </geometry>
    </collision>

    <!-- HEAD -->
    <visual name="head_visual">
      <origin xyz="0.30 0 0.0025" rpy="0 0 0"/>
      <geometry>
        <box size="0.22 0.22 0.005"/>
      </geometry>
      <material name="gray">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision name="head_collision">
      <origin xyz="0.30 0 0.0025" rpy="0 0 0"/>
      <geometry>
        <box size="0.22 0.22 0.005"/>
      </geometry>
    </collision>

  </link>

  <joint name="virtual_joint2" type="fixed">
    <parent link="panda_virtual"/>  
    <child link="spatula_link"/>
    <origin xyz="-0.1 0 -0.06" rpy="0 0 0"/>
  </joint>



</robot>
