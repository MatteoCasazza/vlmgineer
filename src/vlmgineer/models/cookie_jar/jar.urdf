<?xml version="1.0"?>
<robot name="jar">
  <link name="jar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Jar.stl" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="transparent_white">
        <color rgba="1.0 1.0 1.0 0.4"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="Jar.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
  </link>
</robot> 