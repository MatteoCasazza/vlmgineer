<?xml version="1.0" ?>
<robot name="jar.urdf">
  <link name="baseLink">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
       <mass value="0.5"/>
       <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="3.14159265 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="jar.obj" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="white">
       <color rgba="1 1 1 0.3"/>
     </material>
    </visual>
    <collision>
      <origin rpy="3.14159265 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="jar.obj" scale="1.0 1.0 1.0"/>
        <!-- You could also specify the collision (for the jar) with a "box" tag: -->
        <!-- <box size=".06 .06 .06"/> -->
      </geometry>
    </collision>
  </link>
</robot>
        