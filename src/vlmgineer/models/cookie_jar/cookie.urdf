<?xml version="1.0"?>
<robot name="cookie">
  <link name="cookie_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="cookie.obj" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="cookie_texture">
        <texture filename="cookie.png"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="cookie.obj" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
  </link>
</robot> 