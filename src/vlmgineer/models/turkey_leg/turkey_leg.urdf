<?xml version="1.0" ?>
<robot name="turkey_leg">
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="Lowpolyturkleg2.OBJ" scale="1 1 1"/>
            </geometry>
            <material name="turkey_leg_material">
                <texture filename="Lowpolyturkleg2.mtl"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="Lowpolyturkleg2.OBJ" scale="1 1 1"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
    </link>
</robot> 