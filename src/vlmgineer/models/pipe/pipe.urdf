<?xml version="1.0"?>
<robot name="pipe">

  <material name="transparent_white">
      <color rgba="1.0 1.0 1.0 0.7"/>
  </material>

  <material name="red">
      <color rgba="1.0 0.0 0.0 1.0"/>
  </material>

  <link name="pipe">
    <!-- Bottom wall -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.12 0.01"/>
      </geometry>
      <material name="transparent_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.12 0.01"/>
      </geometry>
    </collision>
    
    <!-- Top wall -->
    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.12 0.01"/>
      </geometry>
      <material name="transparent_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.12 0.01"/>
      </geometry>
    </collision>
    
    <!-- Left wall -->
    <visual>
      <origin xyz="0 0.06 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.01 0.12"/>
      </geometry>
      <material name="transparent_white"/>
    </visual>
    <collision>
      <origin xyz="0 0.06 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.01 0.12"/>
      </geometry>
    </collision>
    
    <!-- Right wall -->
    <visual>
      <origin xyz="-0.05 -0.06 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.01 0.12"/>
      </geometry>
      <material name="transparent_white"/>
    </visual>
    <collision>
      <origin xyz="-0.05 -0.06 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.01 0.12"/>
      </geometry>
    </collision>
    
    <!-- Positive X End wall (blocking the opening) -->
    <visual>
      <origin xyz="0.2 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.12 0.12"/>
      </geometry>
      <material name="transparent_white"/>
    </visual>
    <collision>
      <origin xyz="0.2 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.12 0.12"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>
  
  <!-- Extension pipe for L-shape -->
  <link name="extension">
    <!-- Bottom wall -->
    <visual>
      <origin xyz="0 -0.035 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.07 0.01"/>
      </geometry>
      <material name="transparent_white"/>
    </visual>
    <collision>
      <origin xyz="0 -0.035 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.07 0.01"/>
      </geometry>
    </collision>
    
    <!-- Top wall -->
    <visual>
      <origin xyz="-0.005 -0.035 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.07 0.01"/>
      </geometry>
      <material name="transparent_white"/>
    </visual>
    <collision>
      <origin xyz="-0.005 -0.035 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.07 0.01"/>
      </geometry>
    </collision>
    
    <!-- Left wall -->
    <visual>
      <origin xyz="0.05 -0.035 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.07 0.12"/>
      </geometry>
      <material name="transparent_white"/>
    </visual>
    <collision>
      <origin xyz="0.05 -0.035 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.07 0.12"/>
      </geometry>
    </collision>
    
    <!-- Right wall -->
    <visual>
      <origin xyz="-0.057 -0.035 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.07 0.12"/>
      </geometry>
      <material name="transparent_white"/>
    </visual>
    <collision>
      <origin xyz="-0.057 -0.035 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.07 0.12"/>
      </geometry>
    </collision>
    
    <!-- End wall (at negative Y end) -->
    <!-- <visual>
      <origin xyz="0 -0.07 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.01 0.12"/>
      </geometry>
      <material name="transparent_white"/>
    </visual>
    <collision>
      <origin xyz="0 -0.07 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.01 0.12"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.005"/>
    </inertial> -->
  </link>
  
  <!-- Joint to connect the extension to the main pipe -->
  <joint name="pipe_to_extension" type="fixed">
    <parent link="pipe"/>
    <child link="extension"/>
    <origin xyz="0.15 -0.06 0.0" rpy="0 0 0"/>
  </joint>

</robot>
